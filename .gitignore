*.o
.env
.claude/
.tokensave
.serena/
.venv/
__pycache__/

# Zig package dependencies
.zig-pkg/
zig-pkg/

# Zig build artifacts and caches
.zig-cache/
zig-cache/
zig-out/

# ROMs are never committed; the free test ROMs are fetched by
# tools/fetch_test_roms.sh.
roms/

# Save states and SRAM saves written next to a ROM.
*.state
*.srm

# SingleStepTests conformance corpora, fetched by tools/fetch_z80_tests.sh.
testdata/

# Headless --shot output. The icon is art, not output: `zig build icon`
# regenerates it from src/ui/icon.zig, and it is committed.
*.png
!assets/*.png
